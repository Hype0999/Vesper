# Server Environment Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Storage Paths (relative or absolute)
STORAGE_DIR=./storage

# Cookie & Session Security (Change in production!)
SESSION_SECRET=replace_with_a_cryptographically_secure_random_string_at_least_32_characters

# CORS & Origin Validation (Comma-separated allowed origins for state-modifying requests)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://raspberrypi.local:3000,http://travelhub.local:3000

# Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info
